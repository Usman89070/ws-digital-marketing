# === Performance: compression ===
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript
    AddOutputFilterByType DEFLATE application/javascript application/x-javascript application/json
    AddOutputFilterByType DEFLATE image/svg+xml application/xml application/rss+xml
</IfModule>

# === Performance: browser caching for static assets ===
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/css "access plus 1 year"
    ExpiresByType application/javascript "access plus 1 year"
    ExpiresByType text/javascript "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType image/x-icon "access plus 1 year"
    ExpiresByType font/woff2 "access plus 1 year"
    ExpiresByType font/woff "access plus 1 year"
    ExpiresByType text/html "access plus 0 seconds"
</IfModule>

<IfModule mod_headers.c>
    <FilesMatch "\.(css|js|webp|png|jpe?g|svg|ico|woff2?)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
    <FilesMatch "\.(html|php)$">
        Header set Cache-Control "no-cache, must-revalidate"
    </FilesMatch>
</IfModule>

# === Security: block direct download of the raw SQL import file ===
# database.sql only needs to exist here long enough to import through
# phpMyAdmin -- leaving it downloadable would expose the schema and the
# default admin password hash to anyone who requests the URL directly.
<FilesMatch "\.sql$">
    Require all denied
</FilesMatch>

# === Clean URLs: serve every page without its .php extension ===
# /about.php -> /about, /blog-post.php?slug=x -> /blog-post?slug=x, etc.
# The admin panel (admin/) is deliberately excluded -- it's not indexed by
# search engines, and its own internal links are relative .php references
# that don't need to change.
<IfModule mod_rewrite.c>
    RewriteEngine On
    Options -MultiViews

    # 0) The homepage is canonically "/" -- collapse both "/index" and
    #    "/index.php" straight to it instead of leaving "/index" as a second,
    #    duplicate-content URL for the same page.
    RewriteCond %{THE_REQUEST} \s/+index(\.php)?[\s?] [NC]
    RewriteRule ^ / [R=301,L]

    # 0.5) Blog posts are canonically /blog/<slug> -- collapse the older
    #      /blog-post.php?slug=x and /blog-post?slug=x forms straight there
    #      in one hop (placed ahead of the generic .php-stripping rule below,
    #      which would otherwise catch the .php variant first).
    RewriteCond %{THE_REQUEST} \s/+blog-post(\.php)?\?slug=([^\s&]+)[\s&] [NC]
    RewriteRule ^ /blog/%2? [R=301,L]

    # 1) A browser that actually requests a URL ending in .php gets sent to
    #    the same URL minus .php, permanently (301) so bookmarks and search
    #    engines update. THE_REQUEST is the raw request line as the browser
    #    sent it, so this only matches real incoming requests -- never the
    #    internal rewrite in step 2 below, which avoids a redirect loop.
    RewriteCond %{REQUEST_URI} !^/admin/
    RewriteCond %{THE_REQUEST} \s/+(.*)\.php[\s?] [NC]
    RewriteRule ^ /%1 [R=301,L]

    # 2) Internally serve the matching .php file for a clean-URL request,
    #    without changing what's shown in the browser's address bar. Only
    #    fires when the clean path isn't already a real file/directory and
    #    a matching .php file actually exists, so 404s and static assets
    #    (css/, js/, images/) are completely unaffected.
    #
    #    Uses %{DOCUMENT_ROOT}%{REQUEST_URI} rather than %{REQUEST_FILENAME}
    #    deliberately: for a nonexistent multi-segment path like
    #    /blog/some-slug, Apache's own filename translation resolves
    #    REQUEST_FILENAME down to just ".../blog" (silently dropping
    #    "/some-slug" as if it were PATH_INFO on a script named "blog"),
    #    even though "blog" itself doesn't exist either. That truncated
    #    value then wrongly matched "blog.php" here and produced a
    #    self-amplifying rewrite (blog -> blog.php -> blog.php.php -> ...)
    #    until Apache's internal-redirect limit killed the request with a
    #    500. REQUEST_URI is the literal request path with no such
    #    filesystem-based reinterpretation, so this can't happen.
    RewriteCond %{REQUEST_URI} !^/admin/
    RewriteCond %{DOCUMENT_ROOT}%{REQUEST_URI} !-f
    RewriteCond %{DOCUMENT_ROOT}%{REQUEST_URI} !-d
    RewriteCond %{DOCUMENT_ROOT}%{REQUEST_URI}.php -f
    RewriteRule ^(.+)$ $1.php [L]

    # 3) Serve /blog/<slug> from blog-post.php?slug=<slug> internally. Placed
    #    after rule 2 (which never matches this path anyway, since no
    #    literal "blog/<slug>.php" file exists) so it reads as the next step
    #    in the same numbered sequence.
    RewriteRule ^blog/([^/]+)/?$ blog-post.php?slug=$1 [L,QSA]

    # 4) Same pattern for case study detail pages: /case-studies/<slug> is
    #    served from case-study.php?slug=<slug> (singular filename, so it
    #    can never collide with case-studies.php, the listing page itself).
    RewriteRule ^case-studies/([^/]+)/?$ case-study.php?slug=$1 [L,QSA]
</IfModule>
